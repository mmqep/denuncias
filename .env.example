# Copia este archivo a .env y completa los valores.
# El .env NO se versiona (ver .gitignore).

# --- Turso / libSQL ---
# URL de la base Turso (turso db show <db>)
TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
# Token de autenticacion (turso db tokens create <db>)
TURSO_AUTH_TOKEN=

# --- Flask ---
# Secreto de sesiones. Genera uno seguro:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_un_valor_seguro
# 1 = modo debug (desarrollo local), 0 = producción
FLASK_DEBUG=1

# --- Aplicación ---
TIMEZONE=America/Guayaquil
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf
UPLOAD_FOLDER=static/uploads
